# ---------------------------------------------------------------- secrets and data
# A Telegram session file is full access to the account. Never commit it.
*.session
*.session-journal
.env
.env.*
!.env.example

# Raw exports, sessions, database: all in data/, all outside git
data/*
!data/.gitkeep

# Telegram Desktop / WhatsApp exports dropped into the root by accident
result.json
ChatExport_*/
WhatsApp Chat*.txt
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

