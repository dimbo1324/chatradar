# Шаблон конфигурации. Скопируйте в .env и заполните: cp .env.example .env
# Все переменные имеют префикс CHATRADAR_. .env в git не попадает.

# ---------------------------------------------------------------- общее
# dev | prod — в prod логи пишутся в JSON
CHATRADAR_ENV=dev
# DEBUG | INFO | WARNING | ERROR
CHATRADAR_LOG_LEVEL=INFO

# Корень данных: сырые JSONL, сессии, SQLite. В Docker монтируется как volume.
CHATRADAR_DATA_DIR=./data

# ---------------------------------------------------------------- база
# Пусто = sqlite+aiosqlite:///<DATA_DIR>/chatradar.db
# Postgres позже: postgresql+asyncpg://user:pass@db:5432/chatradar
CHATRADAR_DATABASE_URL=

# ---------------------------------------------------------------- Telegram (my.telegram.org → API development tools)
CHATRADAR_TELEGRAM__API_ID=
CHATRADAR_TELEGRAM__API_HASH=
# Имя файла сессии внутри <DATA_DIR>/sessions/
CHATRADAR_TELEGRAM__SESSION_NAME=collector
# FloodWait короче порога Telethon переждёт сам, длиннее — бросит исключение
CHATRADAR_TELEGRAM__FLOOD_SLEEP_THRESHOLD=120

# ---------------------------------------------------------------- воркер
# Интервал синхронизации, часы
CHATRADAR_WORKER__SYNC_INTERVAL_HOURS=4
# Раз в сутки перекачивать последние N дней, чтобы поймать правки
CHATRADAR_WORKER__RECHECK_DAYS=7
# Пауза между чатами, секунды
CHATRADAR_WORKER__PAUSE_BETWEEN_CHATS_SEC=3

# ---------------------------------------------------------------- веб
CHATRADAR_WEB__HOST=127.0.0.1
CHATRADAR_WEB__PORT=8000
