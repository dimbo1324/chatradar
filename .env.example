# Configuration template. Copy it to .env and fill it in: cp .env.example .env
# Every variable has the CHATRADAR_ prefix. .env never reaches git.

# ---------------------------------------------------------------- general
# dev | prod — prod writes JSON logs
CHATRADAR_ENV=dev
# DEBUG | INFO | WARNING | ERROR
CHATRADAR_LOG_LEVEL=INFO

# Data root: raw JSONL, sessions, SQLite. Mounted as a volume in Docker.
CHATRADAR_DATA_DIR=./data

# ---------------------------------------------------------------- database
# Empty = sqlite+aiosqlite:///<DATA_DIR>/chatradar.db
# Postgres later: postgresql+asyncpg://user:pass@db:5432/chatradar
CHATRADAR_DATABASE_URL=

# ---------------------------------------------------------------- Telegram (my.telegram.org → API development tools)
CHATRADAR_TELEGRAM__API_ID=
CHATRADAR_TELEGRAM__API_HASH=
# Session file name inside <DATA_DIR>/sessions/
CHATRADAR_TELEGRAM__SESSION_NAME=collector
# Telethon sleeps through a shorter FloodWait itself and raises on a longer one
CHATRADAR_TELEGRAM__FLOOD_SLEEP_THRESHOLD=120

# ---------------------------------------------------------------- worker
# Sync interval, hours
CHATRADAR_WORKER__SYNC_INTERVAL_HOURS=4
# Once a day refetch the last N days to catch edits
CHATRADAR_WORKER__RECHECK_DAYS=7
# Pause between chats, seconds
CHATRADAR_WORKER__PAUSE_BETWEEN_CHATS_SEC=3

# ---------------------------------------------------------------- web
CHATRADAR_WEB__HOST=127.0.0.1
CHATRADAR_WEB__PORT=8000

# ---------------------------------------------------------------- learning lexicon
# A mined phrase becomes a candidate when it passes all thresholds; a human decides.
CHATRADAR_LEARNING__MIN_OCCURRENCES=5
CHATRADAR_LEARNING__MIN_CHATS=1
CHATRADAR_LEARNING__MIN_AUTHORS=3
CHATRADAR_LEARNING__MIN_SCORE=2.5
CHATRADAR_LEARNING__DORMANT_AFTER_DAYS=180
